<table class="table">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Preço</th>
            <th scope="col">Quantidade</th>
        </tr>
    </thead>
    <tbody>
        @if (Produtos.Count == 0)
        {
            <tr>
                <td colspan="3">
                    <AvisoVazio Mensagem="Nenhum produto cadastrado" />
                </td>
            </tr>
        }
        else
        {
            @foreach (var p in Produtos)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td>R$@p.Preco</td>
                    <td>@p.Quantidade un.</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter]
    public List<Produto> Produtos { get; set; } = new();
}
